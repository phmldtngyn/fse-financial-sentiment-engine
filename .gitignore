$content = @'
# === Python compiled ===
*.pyc
*.pyo
__pycache__/

# === Virtual env ===
venv/
.venv/
env/

# === Env / secrets ===
.env
*.env

# === IDE ===
.vscode/
.idea/
*.swp

# === OS ===
.DS_Store
Thumbs.db

# === File lớn, không commit ===
data/raw/
checkpoints/
.hf_cache/
.cache/
*.pt
*.pth
*.bin
*.safetensors

# === Data runtime (không commit) ===
data/parsed/*.json
data/processed/*.json
data/processed/*.parquet
data/processed/*.pkl
data/crawler_state.json
data/gold_standard/
data/rag_index/index.faiss
fse_3class.zip
fse_data.zip
fse_dapt.zip

# === Ngoại lệ: giữ 3 file 3-class ===
!data/processed/train_3class.parquet
!data/processed/val_3class.parquet
!data/processed/test_3class.parquet

# === Logs ===
*.log
logs/
'@
Set-Content -Path .gitignore -Value $content -Encoding utf8 -NoNewline