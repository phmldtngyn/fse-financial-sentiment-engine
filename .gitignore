@"
# === CHẶN BẮT BUỘC (file lớn > 100MB) ===
venv/
.venv/
env/
data/raw/
checkpoints/
.hf_cache/
.cache/
*.pt
*.pth
*.bin
*.safetensors

# === CHẶN NHẸ (rác IDE, OS) ===
__pycache__/
*.py[cod]
.vscode/
.idea/
.DS_Store
Thumbs.db
.env
*.env

# === CHO PHÉP COMMIT (data nhỏ) ===
# data/processed/*.parquet  (KHÔNG ignore — commit hết)
# data/gold/*.csv           (KHÔNG ignore)
# data/parsed/*.json        (KHÔNG ignore)
# data/crawler_state.json   (KHÔNG ignore)
# data/rag_index/           (KHÔNG ignore — index ~100MB có thể vượt, check)
"@ | Out-File -FilePath .gitignore -Encoding utf8