$lines = @(
'# === File lớn, không commit ==='
'venv/'
'.venv/'
'env/'
'data/raw/'
'checkpoints/'
'.hf_cache/'
'.cache/'
'*.pt'
'*.pth'
'*.bin'
'*.safetensors'
''
'# === Data runtime (không commit) ==='
'data/parsed/*.json'
'data/processed/*.json'
'data/crawler_state.json'
'data/gold_standard/'
'data/rag_index/index.faiss'
''
'# === Ngoại lệ (commit các file quan trọng) ==='
'!data/processed/gold_full.parquet'
'!data/processed/dummy_market.parquet'
'!data/processed/train.parquet'
'!data/processed/val.parquet'
'!data/processed/test.parquet'
''
'# === IDE, OS, cache ==='
'__pycache__/'
'*.py[cod]'
'.vscode/'
'.idea/'
'.DS_Store'
'Thumbs.db'
'.env'
'*.env'
)
Set-Content -Path .gitignore -Value $lines -Encoding utf8
Get-Content .gitignoredata/raw/
checkpoints/
*.pt
